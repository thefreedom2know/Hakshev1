<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/HkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_title" />

        <TextView
            android:id="@+id/tvDate"
            style="@style/HkBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.card.MaterialCardView
                style="@style/HkCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvHeadcount"
                        style="@style/HkBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HkBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/metric_headcount"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/HkCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvCounterCount"
                        style="@style/HkBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HkBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/metric_counters"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/HkCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvAlertCount"
                        style="@style/HkBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/hk_alert"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/HkBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/metric_alerts"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            style="@style/HkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_counters" />

        <com.google.android.material.card.MaterialCardView
            style="@style/HkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvCounters"
                style="@style/HkBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/HkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alerts_title"
            android:textColor="@color/hk_alert" />

        <com.google.android.material.card.MaterialCardView
            style="@style/HkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvAlerts"
                style="@style/HkBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/HkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quick_actions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCounters"
            style="@style/HkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_counters" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewInspection"
            style="@style/HkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_inspection" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReport"
            style="@style/HkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/copy_report" />

        <TextView
            style="@style/HkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screens_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoster"
            style="@style/HkButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_roster" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDuties"
            style="@style/HkButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_duties" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInspections"
            style="@style/HkButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_inspections" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/HkButtonOutlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings" />
    </LinearLayout>
</ScrollView>
