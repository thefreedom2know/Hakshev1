<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/HkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings" />

        <TextView
            style="@style/HkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_unit" />

        <com.google.android.material.card.MaterialCardView
            style="@style/HkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <LinearLayout
                android:id="@+id/formUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveUnit"
                style="@style/HkButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/save" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorOutlineVariant" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditSoldiers"
                style="@style/HkButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/edit_soldiers" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImport"
                style="@style/HkButtonOutlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/import_csv" />
            </LinearLayout>

            <TextView
                style="@style/HkBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/import_csv_hint"
                android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/HkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_sync" />

        <com.google.android.material.card.MaterialCardView
            style="@style/HkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <TextView
                android:id="@+id/tvSyncState"
                style="@style/HkBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncCreate"
                style="@style/HkButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/sync_create" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncJoin"
                style="@style/HkButtonOutlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/sync_join" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncNow"
                style="@style/HkButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/sync_now" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncCode"
                style="@style/HkButtonOutlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/sync_show_code" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSyncLeave"
                style="@style/HkButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/sync_leave" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/HkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_display" />

        <com.google.android.material.card.MaterialCardView
            style="@style/HkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <RadioGroup
                android:id="@+id/rgTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbSystem"
                    style="@style/HkBody"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/theme_system" />

                <RadioButton
                    android:id="@+id/rbDay"
                    style="@style/HkBody"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/theme_day" />

                <RadioButton
                    android:id="@+id/rbRed"
                    style="@style/HkBody"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/theme_red" />

                <RadioButton
                    android:id="@+id/rbNight"
                    style="@style/HkBody"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/theme_night" />

            </RadioGroup>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/HkSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_security" />

        <com.google.android.material.card.MaterialCardView
            style="@style/HkCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <TextView
                android:id="@+id/tvPinState"
                style="@style/HkBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetPin"
                style="@style/HkButtonOutlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/set_pin" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearPin"
                style="@style/HkButtonOutlined"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:text="@string/clear_pin" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/formSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveWipe"
                style="@style/HkButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/save" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWipeAll"
                style="@style/HkButtonOutlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/hk_alert"
                android:text="@string/wipe_all" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
