<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<LinearLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        style="@style/HkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_kind" />

    <Spinner style="@style/HkSpinner"
        android:id="@+id/spKind"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <TextView
        style="@style/HkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_period" />

    <Spinner style="@style/HkSpinner"
        android:id="@+id/spPeriod"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <TextView
        style="@style/HkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_reason_mode" />

    <Spinner style="@style/HkSpinner"
        android:id="@+id/spReason"
        android:layout_width="match_parent"
        android:layout_height="56dp" />

    <LinearLayout
        android:id="@+id/formConvert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <CheckBox
        android:id="@+id/cbDefault"
        style="@style/HkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="@string/default_for_all" />

    <CheckBox
        android:id="@+id/cbAll"
        style="@style/HkBody"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/add_whole_company" />
</LinearLayout>
</ScrollView>
