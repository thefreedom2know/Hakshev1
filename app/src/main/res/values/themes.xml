<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hakshev" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hk_primary</item>
        <item name="colorOnPrimary">@color/hk_on_primary</item>
        <item name="colorSecondary">@color/hk_primary</item>
        <item name="colorOnSecondary">@color/hk_on_primary</item>
        <item name="android:colorBackground">@color/hk_bg</item>
        <item name="colorSurface">@color/hk_surface</item>
        <item name="colorOnSurface">@color/hk_text</item>
        <item name="colorOnBackground">@color/hk_text</item>
        <item name="colorSurfaceVariant">@color/hk_surface</item>
        <item name="colorOnSurfaceVariant">@color/hk_text</item>
        <item name="colorOutline">@color/hk_outline</item>
        <item name="colorError">@color/hk_alert</item>
        <item name="android:textColorPrimary">@color/hk_text</item>
        <item name="android:textColorSecondary">@color/hk_text</item>
        <item name="android:statusBarColor">@color/hk_bg</item>
        <item name="android:navigationBarColor">@color/hk_bg</item>
        <item name="materialButtonStyle">@style/HkButton</item>
    </style>

    <style name="HkTitle" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="HkBody" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Big touch targets: at least 56dp high -->
    <style name="HkButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="HkButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <!-- Square +/- buttons -->
    <style name="HkStepButton" parent="Widget.Material3.Button">
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="HkCard" parent="Widget.Material3.CardView.Outlined">
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
