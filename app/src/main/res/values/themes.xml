<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Hakshev" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hk_primary</item>
        <item name="colorOnPrimary">@color/hk_on_primary</item>
        <item name="colorPrimaryContainer">@color/hk_container</item>
        <item name="colorOnPrimaryContainer">@color/hk_on_container</item>
        <item name="colorSecondary">@color/hk_primary</item>
        <item name="colorOnSecondary">@color/hk_on_primary</item>
        <item name="colorSecondaryContainer">@color/hk_container</item>
        <item name="colorOnSecondaryContainer">@color/hk_on_container</item>
        <item name="android:colorBackground">@color/hk_bg</item>
        <item name="colorSurface">@color/hk_surface</item>
        <item name="colorOnSurface">@color/hk_text</item>
        <item name="colorOnBackground">@color/hk_text</item>
        <item name="colorSurfaceVariant">@color/hk_container</item>
        <item name="colorOnSurfaceVariant">@color/hk_muted</item>
        <item name="colorOutline">@color/hk_outline</item>
        <item name="colorOutlineVariant">@color/hk_outline</item>
        <item name="colorError">@color/hk_alert</item>
        <item name="colorSurfaceContainerLowest">@color/hk_surface</item>
        <item name="colorSurfaceContainerLow">@color/hk_surface</item>
        <item name="colorSurfaceContainer">@color/hk_surface</item>
        <item name="colorSurfaceContainerHigh">@color/hk_surface</item>
        <item name="colorSurfaceContainerHighest">@color/hk_surface</item>
        <item name="android:textColorPrimary">@color/hk_text</item>
        <item name="android:textColorSecondary">@color/hk_muted</item>
        <item name="android:statusBarColor">@color/hk_bg</item>
        <item name="android:navigationBarColor">@color/hk_bg</item>
        <item name="android:windowLightStatusBar">@bool/hk_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/hk_light_bars</item>
        <item name="materialButtonStyle">@style/HkButton</item>
        <item name="hkHero">@color/hk_hero</item>
    </style>

    <!-- Screen title -->
    <style name="HkTitle" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Section header inside a screen -->
    <style name="HkSection" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="HkBody" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Filled flat button, 56dp high -->
    <style name="HkButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/HkShapeButton</item>
    </style>

    <!-- Tonal (secondary) flat button -->
    <style name="HkButtonOutlined" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearance">@style/HkShapeButton</item>
    </style>

    <!-- Square +/- buttons -->
    <style name="HkStepButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="shapeAppearance">@style/HkShapeStep</item>
    </style>

    <style name="HkCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">0dp</item>
        <item name="shapeAppearance">@style/HkShapeCard</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="HkField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="HkSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">44dp</item>
    </style>

    <!-- Angled ("chamfered") corners: a tactical look instead of plain rectangles -->
    <style name="HkShapeButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="HkShapeStep" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="HkShapeCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Optional tactical night mode: black and dim red, no glare (keeps night vision) -->
    <style name="Theme.Hakshev.Red" parent="Theme.Hakshev">
        <item name="colorPrimary">#8A1A1A</item>
        <item name="colorOnPrimary">#FFC8C8</item>
        <item name="colorPrimaryContainer">#2A0A0A</item>
        <item name="colorOnPrimaryContainer">#FF9A9A</item>
        <item name="colorSecondary">#8A1A1A</item>
        <item name="colorOnSecondary">#FFC8C8</item>
        <item name="colorSecondaryContainer">#2A0A0A</item>
        <item name="colorOnSecondaryContainer">#FF9A9A</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#140404</item>
        <item name="colorOnSurface">#E85A5A</item>
        <item name="colorOnBackground">#E85A5A</item>
        <item name="colorSurfaceVariant">#2A0A0A</item>
        <item name="colorOnSurfaceVariant">#B04040</item>
        <item name="colorOutline">#5A1A1A</item>
        <item name="colorOutlineVariant">#3A1010</item>
        <item name="colorSurfaceContainerLowest">#140404</item>
        <item name="colorSurfaceContainerLow">#140404</item>
        <item name="colorSurfaceContainer">#140404</item>
        <item name="colorSurfaceContainerHigh">#140404</item>
        <item name="colorSurfaceContainerHighest">#140404</item>
        <item name="android:textColorPrimary">#E85A5A</item>
        <item name="android:textColorSecondary">#B04040</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="hkHero">#2A0A0A</item>
    </style>
</resources>
